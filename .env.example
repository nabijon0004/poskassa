# Set a long random value before exposing staff diagnostics.
KIOSK_ADMIN_TOKEN=

# Network ESC/POS thermal printer, normally raw TCP port 9100.
# The driver prints a centered, enlarged order number and optional comment.
# ESC/POS code page; 17 is commonly CP866 (verify against the printer manual).
KIOSK_PRINTER_HOST=
KIOSK_PRINTER_PORT=9100
KIOSK_PRINTER_TIMEOUT=3
KIOSK_PRINTER_CODEPAGE=17
KIOSK_PRINTER_ENCODING=cp866

# Local display preferences. Replace with restaurant-approved values.
KIOSK_CURRENCY=с
# Orders above this total must be placed at the cash desk.
KIOSK_MAX_ORDER_TOTAL=1000
# Order numbers shown to customers run 1..N and then restart from 1.
KIOSK_ORDER_NUMBER_MAX=50
KIOSK_DB_PATH=./data/kiosk.sqlite3
LOG_LEVEL=INFO
