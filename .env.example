# Admin panel (/admin). The first owner is created at startup when no owner exists yet.
# The password must be at least 8 characters; change it later in the admin panel.
KIOSK_OWNER_LOGIN=owner
KIOSK_OWNER_PASSWORD=

# Default printer settings for stores whose printer is not set in the admin panel yet.
# Network ESC/POS thermal printer in the store's local network, normally raw TCP port 9100.
# ESC/POS code page; 17 is commonly CP866 (verify against the printer manual).
KIOSK_PRINTER_HOST=
KIOSK_PRINTER_PORT=9100
KIOSK_PRINTER_TIMEOUT=3
KIOSK_PRINTER_CODEPAGE=17
KIOSK_PRINTER_ENCODING=cp866

# Display preferences. Replace with restaurant-approved values.
KIOSK_CURRENCY=с
# Orders above this total must be placed at the cash desk.
KIOSK_MAX_ORDER_TOTAL=1000
# Order numbers shown to customers run 1..N in each store and then restart from 1.
KIOSK_ORDER_NUMBER_MAX=50
KIOSK_DB_PATH=./data/kiosk.sqlite3
LOG_LEVEL=INFO

# Customer queue screen («Готовится» / «Готово»), served on its own port by the same
# server. 0 disables it. Ready orders stay on the screen for KIOSK_QUEUE_READY_SECONDS.
KIOSK_QUEUE_HOST=0.0.0.0
KIOSK_QUEUE_PORT=8001
KIOSK_QUEUE_READY_SECONDS=300
# Public address of the queue screen behind a reverse proxy, e.g. https://queue.example.com.
# Empty: activation links use this server's host name and KIOSK_QUEUE_PORT.
KIOSK_QUEUE_PUBLIC_URL=
